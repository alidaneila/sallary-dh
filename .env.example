# Token bot Discord (Developer Portal > Bot > Token)
DISCORD_TOKEN=

# Client ID aplikasi bot (Developer Portal > General Information > Application ID)
CLIENT_ID=

# Guild ID server tempat bot dipakai (klik kanan server > Copy Server ID, aktifkan Developer Mode dulu)
GUILD_ID=

# ID channel tempat semua thread salary dibuat
SALARY_CHANNEL_ID=

# Discord User ID satu-satunya orang yang boleh pakai /setting item (klik kanan nama user > Copy User ID)
ITEM_ADMIN_USER_ID=

# Lokasi file database SQLite (default sudah cukup)
DB_PATH=./data/bot.sqlite
